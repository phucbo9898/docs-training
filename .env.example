# Mẫu biến môi trường. Copy thành `.env.local` rồi điền giá trị thật.
# Không commit `.env.local` (.gitignore đã chặn .env*).

# Auth.js: tạo bằng `openssl rand -base64 32`.
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Chỉ cần khi chạy `next start` ở máy (Vercel tự tin cậy host).
# AUTH_TRUST_HOST=true

# Neon Postgres (lưu kết quả làm bài). Lấy từ Vercel > Storage > Neon hoặc
# Neon Console > Connection string. Dùng `npm run db:migrate` để tạo bảng.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
